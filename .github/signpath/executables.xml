<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration d'artefact SignPath « executables » : nos deux .exe, avant l'emballage NSIS.
     Seuls nos propres binaires sont signés (pas les DLL d'Electron ni de Python). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="HOTS REVIVAL.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="resources/backend/hots-backend.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
