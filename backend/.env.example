# Copier en .env puis adapter.
# Optionnel (développement uniquement) : par défaut SQLite dans %APPDATA%\HOTS REVIVAL.
# Les joueurs règlent tout depuis l’écran Paramètres de l’application.
# HOTS_DATABASE_URL=postgresql+psycopg://hots:hots@localhost:5432/hots_revival
# Dossier des replays (auto-détecté sous Documents\Heroes of the Storm\Accounts si vide)
# HOTS_REPLAY_DIR=C:\Users\<vous>\Documents\Heroes of the Storm\Accounts\<id>\<toon>\Replays\Multiplayer
# Identité du joueur (le toon handle est déduit du chemin si absent)
HOTS_PLAYER_BATTLETAG=
HOTS_PLAYER_TOON_HANDLE=
HOTS_WATCH_REPLAYS=true
HOTS_WATCH_LIVE=true

# Coach IA (optionnel, réglable aussi dans Paramètres). Sans IA, le coach renvoie une analyse déterministe.
# Fournisseurs : anthropic | gemini | openai | mistral | openrouter | ollama | custom (toute API compatible OpenAI)
HOTS_AI_PROVIDER=anthropic
# Clé lue selon le fournisseur choisi (ollama : aucune clé)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Modèle par fournisseur (vide = modèle par défaut), ex. {"gemini": "gemini-flash-latest"}
# HOTS_AI_MODELS={}
# Fournisseur « custom » uniquement : adresse de l'API compatible OpenAI
# HOTS_AI_BASE_URL=http://localhost:1234/v1
HOTS_CLAUDE_MODEL=claude-opus-5-5
HOTS_CLAUDE_EFFORT=medium

# Observabilité (opt-in)
HOTS_SENTRY_DSN=
HOTS_POSTHOG_KEY=
HOTS_POSTHOG_HOST=https://eu.i.posthog.com
